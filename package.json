{
  "name": "bundle-secret-guard",
  "version": "1.1.0",
  "description": "Fail your build when secrets or API keys end up in the frontend bundle (dist/, build/, .next/static, out/). Provider patterns, gitleaks TOML rules, entropy + baseline, optional live-key verification, .env cross-check, source map scanning, Vite & webpack plugins, JSON & SARIF output. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "import": "./dist/patterns.js",
      "require": "./dist/patterns.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js",
      "require": "./dist/webpack.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bundle-secret-guard": "bin/bundle-secret-guard.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "security",
    "secrets",
    "secret-scanning",
    "api-keys",
    "leak",
    "bundle",
    "frontend",
    "vite",
    "vite-plugin",
    "webpack",
    "nextjs",
    "env",
    "dotenv",
    "gitleaks",
    "entropy",
    "baseline",
    "ci",
    "cli",
    "github-action",
    "sarif",
    "devsecops"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/bundle-secret-guard.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/bundle-secret-guard/issues"
  },
  "homepage": "https://github.com/MrLouisWright/bundle-secret-guard#readme",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  }
}
